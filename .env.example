# Copy this to .env (chmod 600) and fill in — install.sh does this for you
# interactively. Never commit the real .env.

# GitHub Personal Access Token with `repo` and `issues` scopes.
GITHUB_TOKEN=

# From `claude setup-token`, run inside a container built from this image
# (install.sh does this for you): bills against a Claude Pro/Max
# subscription. See README "Configuration" for the exact command.
CLAUDE_CODE_OAUTH_TOKEN=

# Repository the factory operates on, as owner/name.
TARGET_REPO=

# How often (seconds) the factory polls for actionable issues.
POLL_INTERVAL_SECONDS=300

# Fix/review cycles allowed per stage before an issue is labeled `blocked`.
MAX_RETRIES=3

# Set to 1 to simulate a cycle without writing to GitHub or pushing commits.
DRY_RUN=0

# Optional: only do agent work within a daily time window (24h "HH:MM", in
# TZ below). Merge-checking already-reviewed PRs still happens any time —
# only Claude-calling stages are gated by this. Leave both blank to run
# continuously. Example: nightly 11pm-3am.
# WORK_WINDOW_START=23:00
# WORK_WINDOW_END=03:00
TZ=UTC

# Optional: cap total Claude spend (USD, from each call's reported cost) per
# window — one scheduled window if configured above, otherwise one calendar
# day. Work pauses once hit and resumes at the start of the next window.
# MAX_SPEND_PER_WINDOW=15
